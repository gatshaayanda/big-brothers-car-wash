rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }
    match /gallery/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    match /gallery-submissions/{uid}/{fileName} {
      // Customers may upload an image or short video for review only into their own isolated folder.
      // Files are not published by Storage rules; staff moderation is required.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        );
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
