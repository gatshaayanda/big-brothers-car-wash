# Big Brothers Car Wash environment example.
# Public Firebase web settings intentionally target the existing Vula Firebase project.
# Copy the NEXT_PUBLIC_FIREBASE_* web values from the existing Vula deployment settings.
# This reuses that Firebase project's data; it is not a separate database.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vulas-car-wash.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vulas-car-wash
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vulas-car-wash.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only JSON for a service account created specifically for Big Brothers.
# Keep the real credential in the deployment environment only; never commit it.
FIREBASE_ADMIN_KEY=
BIG_BROTHERS_OPERATIONS_WORD=
BIG_BROTHERS_REMINDER_CRON_SECRET=
UPLOADTHING_TOKEN=
# Used only by the manual Firebase rules/indexes deployment workflow.
FIREBASE_PROJECT_ID=vulas-car-wash
